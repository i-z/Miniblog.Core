@model Miniblog.Core.Models.GeoInfoViewModel
@{
    ViewData[Constants.Title] = "Your Location";
    ViewData[Constants.Description] = "View your IP address and estimated location";
}

<div class="container">
    <article>
        <h2>Your Location Info</h2>

        <table style="margin: 2em 0; border-collapse: collapse; width: 100%; max-width: 500px;">
            <tr>
                <td style="padding: 8px 16px; font-weight: bold; border-bottom: 1px solid #ddd;">IP Address</td>
                <td style="padding: 8px 16px; border-bottom: 1px solid #ddd;">@Model.IpAddress</td>
            </tr>
            @if (Model.Country is not null)
            {
                <tr>
                    <td style="padding: 8px 16px; font-weight: bold; border-bottom: 1px solid #ddd;">Country</td>
                    <td style="padding: 8px 16px; border-bottom: 1px solid #ddd;">@Model.Country</td>
                </tr>
            }
            @if (Model.City is not null)
            {
                <tr>
                    <td style="padding: 8px 16px; font-weight: bold; border-bottom: 1px solid #ddd;">City</td>
                    <td style="padding: 8px 16px; border-bottom: 1px solid #ddd;">@Model.City</td>
                </tr>
            }
        </table>

        @if (Model.ErrorMessage is not null)
        {
            <p style="color: #888; font-style: italic;">@Model.ErrorMessage</p>
        }
    </article>
</div>
